# Compose reads .env locally. Put the actual credential in the service environment.
LLM_BASE_URL=https://your-model-service.example/v1
LLM_MODEL=your-tool-calling-model
LLM_API_KEY=
DOCKER_GID=
FAMSUN_PUBLIC_ORIGIN=https://agent.example.org
FAMSUN_SECURE_COOKIES=true
FAMSUN_ALLOW_SIGNUP=false
FAMSUN_MAX_PARALLEL_RUNS=4
# Optional official LangChain documentation lookup, connected only on use.
FAMSUN_MCP_ENABLED=false
# Optional operator-only Langfuse project for distributed tracing.
FAMSUN_LANGFUSE_ENABLED=false
FAMSUN_LANGFUSE_CAPTURE_CONTENT=false
# Set true for compatible model providers supporting stream_options.include_usage.
FAMSUN_LLM_STREAM_USAGE=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
FAMSUN_PREVIEW_IMAGE=famsun-preview:local
